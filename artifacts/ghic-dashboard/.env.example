# Server-only dashboard configuration. Set these in Vercel and never expose
# them through a VITE_ prefix.
DATABASE_URL=
FIREBASE_PROJECT_ID=your-project

# Public GHIC health endpoint. Product data is queried from PostgreSQL by the
# authenticated server route; no shared GHIC API token is required.
GHIC_API_URL=https://github-issue-classifier-dun.vercel.app

# Firebase browser configuration. These identify the Firebase project and are
# intentionally public; provider secrets remain in Firebase.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

VITE_MARKETING_URL=https://ghic-website.vercel.app

# Local/build configuration used by the existing Vite setup.
PORT=5173
BASE_PATH=/
