# --- GHIC dashboard -------------------------------------------------------
# Set these in the Vercel project environment (and in a local `.env` for
# development). They are read by the serverless API route, never by the
# browser bundle — the token must not reach the client.

# The GHIC backend. Defaults to the deployed instance if unset.
GHIC_API_URL=https://github-issue-classifier-dun.vercel.app

# REQUIRED. Same value as GHIC_WEBHOOK_SECRET on the GHIC deployment —
# that is what its token-gated endpoints (/stats, /repositories,
# /automation/*) check against.
#
# Without it the dashboard still loads and system health still works
# (/healthz is public), but authenticated metrics read as "—" and a
# critical alert says the token is missing. It never renders zeros in
# place of data it could not fetch.
GHIC_API_TOKEN=

# --- Vite build (Replit scaffold requires both) ---------------------------
# vite.config.ts throws without them; vercel.json sets them at build time.
PORT=5173
BASE_PATH=/
